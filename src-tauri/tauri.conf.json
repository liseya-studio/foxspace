{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fox Space",
  "version": "0.1.0",
  "identifier": "studio.liseya.foxspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fox Space",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg"]
  }
}
